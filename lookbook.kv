#:import dp kivy.metrics.dp

<LookCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(360)
    padding: dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.13, 0.14, 0.17, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Image:
        source: root.image_path
        allow_stretch: True
        keep_ratio: True
    Label:
        text: root.look_name
        size_hint_y: None
        height: dp(32)
        bold: True
        font_size: "18sp"
        shorten: True
        shorten_from: "right"
    Label:
        text: root.detail_text
        size_hint_y: None
        height: dp(64)
        font_size: "12sp"
        halign: "left"
        valign: "middle"
        text_size: self.width, self.height
    BoxLayout:
        size_hint_y: None
        height: dp(46)
        spacing: dp(6)
        Button:
            text: "Wore this"
            on_release: app.mark_look_worn(root.look_id)
        Button:
            text: "Edit"
            size_hint_x: .55
            on_release: app.open_edit_look(root.look_id)

<ItemCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(360)
    padding: dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.13, 0.14, 0.17, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
    Image:
        source: root.image_path
        allow_stretch: True
        keep_ratio: True
    Label:
        text: root.item_name
        size_hint_y: None
        height: dp(32)
        bold: True
        font_size: "18sp"
        shorten: True
        shorten_from: "right"
    Label:
        text: root.detail_text
        size_hint_y: None
        height: dp(60)
        font_size: "12sp"
        halign: "left"
        valign: "middle"
        text_size: self.width, self.height
    BoxLayout:
        size_hint_y: None
        height: dp(46)
        spacing: dp(6)
        Button:
            text: "Wore this"
            on_release: app.mark_item_worn(root.item_id)
        Button:
            text: "Edit"
            size_hint_x: .55
            on_release: app.open_edit_item(root.item_id)

<LooksScreen>:
    name: "looks"
    BoxLayout:
        orientation: "vertical"
        spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(6)
            TextInput:
                id: look_search
                hint_text: "Search looks..."
                multiline: False
                padding: dp(10), dp(12)
                on_text: app.refresh_looks()
            Button:
                text: "+ Add"
                size_hint_x: None
                width: dp(92)
                on_release: app.open_add_look()
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            Spinner:
                id: look_tag_spinner
                text: "All tags"
                values: app.look_tag_choices
                on_text: app.set_look_tag(self.text)
            Button:
                text: "A–Z"
                size_hint_x: None
                width: dp(72)
                on_release: app.set_look_sort("name")
            Button:
                text: "Oldest"
                size_hint_x: None
                width: dp(88)
                on_release: app.set_look_sort("oldest")
        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)
            GridLayout:
                id: look_grid
                cols: 1 if self.width < dp(650) else 2
                spacing: dp(8)
                padding: dp(2), dp(2), dp(2), dp(10)
                size_hint_y: None
                height: self.minimum_height

<ItemsScreen>:
    name: "items"
    BoxLayout:
        orientation: "vertical"
        spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(6)
            TextInput:
                id: item_search
                hint_text: "Search clothing..."
                multiline: False
                padding: dp(10), dp(12)
                on_text: app.refresh_items()
            Button:
                text: "+ Add"
                size_hint_x: None
                width: dp(92)
                on_release: app.open_add_item()
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            Spinner:
                id: body_area_spinner
                text: "All body areas"
                values: app.body_area_choices
                on_text: app.set_body_area(self.text)
            Spinner:
                id: item_tag_spinner
                text: "All tags"
                values: app.item_tag_choices
                on_text: app.set_item_tag(self.text)
        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(6)
            Button:
                text: "Sort A–Z"
                on_release: app.set_item_sort("name")
            Button:
                text: "Least recently worn"
                on_release: app.set_item_sort("oldest")
        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)
            GridLayout:
                id: item_grid
                cols: 1 if self.width < dp(650) else 2
                spacing: dp(8)
                padding: dp(2), dp(2), dp(2), dp(10)
                size_hint_y: None
                height: self.minimum_height

<SandboxScreen>:
    name: "sandbox"
    ScrollView:
        do_scroll_x: False
        bar_width: dp(4)
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            padding: 0, 0, 0, dp(12)

            Label:
                text: "BUILD A LOOK"
                size_hint_y: None
                height: dp(30)
                bold: True
                font_size: "17sp"

            Label:
                text: "Tap an item to add or remove it"
                size_hint_y: None
                height: dp(26)
                font_size: "12sp"

            GridLayout:
                id: sandbox_available
                cols: 1
                spacing: dp(5)
                size_hint_y: None
                height: self.minimum_height

            BoxLayout:
                size_hint_y: None
                height: dp(46)
                spacing: dp(6)
                Button:
                    text: "Clear"
                    on_release: app.clear_sandbox()
                Button:
                    text: "Save as look idea"
                    on_release: app.save_sandbox_idea()

            Label:
                text: "CURRENT LOOK"
                size_hint_y: None
                height: dp(32)
                bold: True
                font_size: "16sp"

            GridLayout:
                id: sandbox_head
                cols: 1
                size_hint_y: None
                height: self.minimum_height
            GridLayout:
                id: sandbox_upper_body
                cols: 1
                size_hint_y: None
                height: self.minimum_height
            GridLayout:
                id: sandbox_legs
                cols: 1
                size_hint_y: None
                height: self.minimum_height
            GridLayout:
                id: sandbox_feet
                cols: 1
                size_hint_y: None
                height: self.minimum_height

            Label:
                text: "SAVED LOOK IDEAS"
                size_hint_y: None
                height: dp(34)
                bold: True
                font_size: "16sp"

            GridLayout:
                id: saved_ideas
                cols: 1
                spacing: dp(6)
                size_hint_y: None
                height: self.minimum_height

<RootWidget>:
    orientation: "vertical"
    padding: dp(7)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: .055, .06, .075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "LOOKBOOK"
        size_hint_y: None
        height: dp(42)
        bold: True
        font_size: "22sp"
        halign: "center"
        valign: "middle"
        text_size: self.size

    ScreenManager:
        id: manager
        LooksScreen:
            id: looks_screen
        ItemsScreen:
            id: items_screen
        SandboxScreen:
            id: sandbox_screen

    BoxLayout:
        size_hint_y: None
        height: dp(52)
        spacing: dp(6)
        Button:
            text: "Looks"
            on_release: app.show_screen("looks")
        Button:
            text: "Items"
            on_release: app.show_screen("items")
        Button:
            text: "Sandbox"
            on_release: app.show_screen("sandbox")
